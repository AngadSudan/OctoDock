{
  "compilerOptions": {
    "target": "ES2020", // or ES2019/ES2022 depending on Node version
    "module": "commonjs", // or "ESNext" if you're using ESM imports
    "rootDir": "src", // where your .ts files live
    "outDir": "dist", // where compiled .js files go
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
